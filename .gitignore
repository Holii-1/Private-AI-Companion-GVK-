# =====================================================================
# GVK Private AI — Безпековий .gitignore
# Гарантує принцип Zero-Plaintext-At-Rest та запобігає витоку лору й ключів
# =====================================================================

# ---------------------------------------------------------------------
# 1. КРИПТОГРАФІЧНІ КЛЮЧІ ТА ПІДПИСИ (СУВОРО ЗАБОРОНЕНО В РЕПОЗИТОРІЇ!)
# ---------------------------------------------------------------------
*.key
*.pem
*.bin
*.sig
master.key
origin.sig
vault/
.env
.env.*

# ---------------------------------------------------------------------
# 2. СИРІ ДАНІ ЧАТІВ ТА ПРИВАТНІ ЛОГИ (Zero-Leak)
# ---------------------------------------------------------------------
# Експорти Telegram та датасети для тренування
result.json
chats/
raw_chats/
data/
datasets/
*.jsonl
# Метадані та приватні промпти у відкритому вигляді
prompt.txt
persona_config.json
tools.py
!core/
!tools/

# ---------------------------------------------------------------------
# 3. НЕЗАШИФРОВАНІ ВАГИ ШІ ТА ВЕКТОРНІ БАЗИ
# ---------------------------------------------------------------------
adapters/
*.gguf
*.safetensors
*.pt
*.bin
*.onnx
*.faiss
*.index

# ---------------------------------------------------------------------
# 4. ВАЖКІ БАЗОВІ МОДЕЛІ (Навіть зашифровані > 100 МБ блокуються GitHub)
# ---------------------------------------------------------------------
# Базова модель (5 ГБ) живе тільки на Blu-ray та в локальному кеші SSD
base_model.gguf.enc
base/
*.iso

# ---------------------------------------------------------------------
# 5. СКОМПІЛЬОВАНІ БІНАРНИКИ RUNTIME
# ---------------------------------------------------------------------
llama-server
llama-server.exe
llama-cli
llama-cli.exe
*.dylib
*.so
*.dll

# ---------------------------------------------------------------------
# 6. КЕШІ ТА СЕРЕДОВИЩЕ PYTHON
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Віртуальні оточення
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------
# 7. СИСТЕМНІ ФАЙЛИ ТА IDE
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
