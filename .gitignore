# =====================================================================
# GVK Private AI — Security .gitignore
# Enforces the Zero-Plaintext-At-Rest principle and prevents lore and key leaks
# =====================================================================

# ---------------------------------------------------------------------
# 1. CRYPTOGRAPHIC KEYS AND SIGNATURES (STRICTLY FORBIDDEN IN REPOSITORY!)
# ---------------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.asc
*.gpg
*.kdbx
*.bin
*.sig
master.key
origin.sig
vault/
.env
.env.*

# ---------------------------------------------------------------------
# 2. RAW CHAT DATA, ARCHIVES, MEDIA, AND PRIVATE LOGS (Zero-Leak)
# ---------------------------------------------------------------------
# Telegram exports, databases, and training datasets
result.json
raw_chats_and_prompts/
data/
datasets/
*.jsonl
*.ndjson
*.csv
*.tsv
*.db
*.sqlite
*.sqlite3
*.dump
# Plaintext metadata and private prompts
prompt.txt
memory.txt
memories.txt
memories.json
persona_config.json
roster.json
builder_config*.json
tools.py
!core/
!tools/
portraits/
personas/
# Logs and debug output
logs/
*.log
*.log.*
*.out
*.err
nohup.out
crash*.txt
debug*.txt
# Backups and temporary files
backup/
backups/
*.bak
*.tmp
*.temp
*.orig
*.rej
# Private photos, screenshots, video, audio, and documents
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff
*.heic
*.heif
*.psd
*.xcf
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.ogg
*.m4a
*.pdf
# Allowed media files (pictures, video, audio) for documentation in docs/
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp
!docs/**/*.gif
!docs/**/*.bmp
!docs/**/*.tiff
!docs/**/*.heic
!docs/**/*.heif
!docs/**/*.mp4
!docs/**/*.mov
!docs/**/*.avi
!docs/**/*.mkv
!docs/**/*.mp3
!docs/**/*.wav
!docs/**/*.ogg
!docs/**/*.m4a
# Any archives and disk images (leak risk + GitHub 100 MB limit)
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.zst
*.gz
*.bz2
*.xz
*.dmg
*.img
*.cdr

# ---------------------------------------------------------------------
# 3. UNENCRYPTED AI WEIGHTS AND VECTOR DATABASES
# ---------------------------------------------------------------------
adapters/
lora_final/
lora_stage1/
outputs_stage1/
outputs_stage2/
checkpoints/
*.gguf
*.safetensors
*.pt
*.onnx
*.faiss
*.index
*.part

# ---------------------------------------------------------------------
# 4. LARGE BASE MODELS (Even encrypted, files > 100 MB are blocked by GitHub)
# ---------------------------------------------------------------------
# The base model (5 GB) lives only on Blu-ray and in the local SSD cache
base_model.gguf.enc
base/
*.iso

# ---------------------------------------------------------------------
# 5. COMPILED RUNTIME BINARIES
# ---------------------------------------------------------------------
llama-server
llama-server.exe
llama-cli
llama-cli.exe
*.dylib
*.so
*.dll
*.metal
*.metallib

# ---------------------------------------------------------------------
# 6. PYTHON CACHES AND ENVIRONMENT
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
.gvk_ai/
.coverage
htmlcov/
graphify-out/

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------
# 7. SYSTEM AND IDE FILES
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~